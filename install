#!/usr/bin/env ruby

# based off of http://errtheblog.com/posts/89-huba-huba

dotfiles = File.expand_path('..', __FILE__)
home = File.expand_path('~')

# Only what is listed here is linked; everything else in the repo stays put.
# Each entry links to ~/.<name>.
HOME_LINKS = %w[bash bash_profile bashrc vimrc zshrc]

# Each entry in ./claude links to ~/.claude/<name>. ~/.claude also holds
# Claude Code's own runtime data (sessions, history, caches), so it stays a
# real directory rather than a link to ./claude.
CLAUDE_LINKS = %w[CLAUDE.md commands mods scripts settings.json skills]

def link(source, target)
  if !File.exist?(source)
    puts "Skipping #{target}: #{source} is listed but missing"
  elsif File.symlink?(target)
    return
  elsif File.exist?(target)
    puts "Skipping #{target}: it exists and is not a symlink"
  else
    `ln -s #{source} #{target}`
  end
end

HOME_LINKS.each do |name|
  link(File.join(dotfiles, name), File.join(home, ".#{name}"))
end

claude_home = File.join(home, '.claude')
if File.symlink?(claude_home)
  puts "#{claude_home} is a symlink; replace it with a real directory so Claude Code's runtime data stays out of this repo"
else
  Dir.mkdir(claude_home) unless File.directory?(claude_home)

  CLAUDE_LINKS.each do |name|
    link(File.join(dotfiles, 'claude', name), File.join(claude_home, name))
  end
end

# Clone external git repos that live outside the dotfiles repo.
# Add entries to ./external_repos to extend this.
external_repos_file = File.join(dotfiles, 'external_repos')
if File.exist?(external_repos_file)
  File.readlines(external_repos_file).each do |line|
    line.strip!
    next if line.empty? || line.start_with?('#')
    rel_path, url = line.split(' ', 2)
    dest = File.join(dotfiles, rel_path)
    unless File.directory?(dest)
      puts "Cloning #{url} -> #{dest}"
      system("git clone #{url} #{dest}")
    end
  end
end
