{
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/context-meter"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Grep",
      "Glob",
      "Read",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(printf *)",
      "Bash(rg *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh repo list *)",
      "Bash(gh workflow view *)",
      "Bash(gh workflow list *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(gh label list *)",
      "Bash(gh cache list *)",
      "Bash(gh search *)",
      "Bash(gh auth status *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh run list *)",
      "Bash(gh run download *)",
      "Bash(bundle exec rspec *)",
      "Bash(rails routes *)",
      "Bash(~/.claude/scripts/validate-commit-msg.sh*)",
      "Bash(/Users/jaredshay/.claude/plugins/cache/claude-plugins-official/superpowers/*)",
      "mcp__executor__skills",
      "mcp__executor__execute",
      "mcp__executor__resume",
      "mcp__executor__tools_search"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "python-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "model": "sonnet"
}
